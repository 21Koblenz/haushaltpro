# PUBLIC/HTTPS: HaushaltPro NICHT direkt per Portweiterleitung veröffentlichen.
# Der Reverse Proxy läuft auf demselben Host und leitet HTTPS -> 127.0.0.1:8080 weiter.
HAUSHALTPRO_BIND_IP=127.0.0.1
HAUSHALTPRO_MODE=public
SECURE_COOKIES=true
TRUST_PROXY_HEADERS=true
ENFORCE_HTTPS=true
ALLOW_SELF_REGISTRATION=false

# Exakter öffentlicher Hostname, mehrere mit Komma. Kein * im Public-Modus.
ALLOWED_HOSTS=haushalt.example.de

# Nur für die allererste Einrichtung. Mindestens 24 zufällige Zeichen.
# Danach kann der Wert entfernt werden; /api/setup ist nach Einrichtung ohnehin gesperrt.
PUBLIC_SETUP_TOKEN=BITTE_MIT_ZUFAELLIGEM_TOKEN_ERSETZEN

# Nur aktivieren, wenn wirklich ALLE Subdomains ausschließlich per HTTPS erreichbar sind.
HSTS_INCLUDE_SUBDOMAINS=false

# Public defaults – kürzere Sitzungen.
SESSION_TTL_MINUTES=120
TRUSTED_SESSION_TTL_DAYS=7
MAX_REQUEST_BYTES=26214400
